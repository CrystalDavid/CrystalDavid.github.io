{
  "name": "david-personal-site",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @david/web",
    "build": "npm run build --workspace @david/web",
    "start": "npm run start --workspace @david/web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run build && npm run test:rendered --workspace @david/web",
    "test:rendered": "npm run test:rendered --workspace @david/web"
  },
  "type": "module"
}
