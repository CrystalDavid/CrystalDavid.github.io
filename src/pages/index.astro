---
import BaseLayout from '../layouts/BaseLayout.astro';
import { education, projects } from '../data/site';
import { publications } from '../data/publications';
import Authors from '../components/Authors.astro';
---
<BaseLayout>
  <section id="about" class="home-section" data-section aria-labelledby="about-title">
    <h2 id="about-title">About Me</h2>
    <p>I’m David, a student in Data Science and Big Data Technology at <a href="https://www.sustech.edu.cn/en/" target="_blank" rel="noopener noreferrer">Southern University of Science and Technology (SUSTech)</a>, Shenzhen. I focus on building AI agents and turning complex workflows into clear, polished and efficient products. I enjoy making tools that reduce repetitive work and help people get things done.</p>
  </section>
  <section id="education" class="home-section" data-section aria-labelledby="education-title">
    <h2 id="education-title">Education</h2>
    <div class="education-entry">
      <p class="education-school"><strong>{education.school}</strong></p>
      <p class="education-period">{education.period}</p>
      <p class="education-degree">{education.degree} in {education.major}</p>
    </div>
  </section>
  <section id="interests" class="home-section" data-section aria-labelledby="interests-title">
    <h2 id="interests-title">Research Interests</h2>
    <ul class="interest-list"><li>Large Language Models and AI Agents</li><li>Agent Workflows and Tool Use</li><li>Group-Robust Learning</li></ul>
  </section>
  <section id="writing" class="home-section publications" data-section aria-labelledby="writing-title">
    <h2 id="writing-title">Publications & Manuscripts</h2>
    {publications.map(publication => { const ImageTag = publication.notesAvailable ? 'a' : 'div'; return <article class="publication-row" id={`article-card-${publication.slug}`}>
      <ImageTag class="publication-image" href={publication.notesAvailable ? `/articles/${publication.slug}/` : undefined} data-astro-prefetch={publication.notesAvailable ? '' : undefined} aria-label={publication.notesAvailable ? publication.name : undefined}><img src={publication.coverImage} alt={publication.coverAlt} width="1280" height="720" loading="lazy" decoding="async" /></ImageTag>
      <div class="publication-copy">
        <h3>{publication.notesAvailable ? <a href={`/articles/${publication.slug}/`} data-astro-prefetch>{publication.title}</a> : publication.title}</h3>
        <p class="publication-authors"><Authors authors={publication.authors} /></p><p class="publication-venue">{publication.status.en}</p>
        {(publication.preprint || publication.notesAvailable) && <div class="publication-links">{publication.preprint && <a href={publication.preprint} target="_blank" rel="noopener noreferrer">arXiv</a>}{publication.notesAvailable && <a href={`/articles/${publication.slug}/`} data-astro-prefetch>Notes</a>}</div>}
      </div>
    </article>; })}
  </section>
  <section id="projects" class="home-section publications" data-section aria-labelledby="projects-title">
    <h2 id="projects-title">Projects</h2>
    {projects.map(project => <article class="publication-row" id={`article-card-${project.article}`}>
      <a class="publication-image project-image" href={`/articles/${project.article}/`} data-astro-prefetch aria-label={project.name}><img src={project.image} alt={project.alt.en} width="900" height="600" loading="lazy" decoding="async" /></a>
      <div class="publication-copy"><h3><a href={`/articles/${project.article}/`} data-astro-prefetch>{project.name}</a></h3><p class="publication-venue">{project.type.en}</p><div class="publication-links"><a href={project.github} target="_blank" rel="noopener noreferrer">Code</a>{project.demo && <a href={project.demo} target="_blank" rel="noopener noreferrer">Demo</a>}<a href={`/articles/${project.article}/`} data-astro-prefetch>Article</a></div></div>
    </article>)}
  </section>
</BaseLayout>
