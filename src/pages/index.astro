---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile, projects } from '../data/site';
import { articles } from '../data/articles';
import { publications } from '../data/publications';
import Authors from '../components/Authors.astro';
---
<BaseLayout>
  <section id="about" class="home-section" data-section aria-labelledby="about-title">
    <h2 id="about-title">About Me</h2>
    <p>I’m David, a student in Data Science and Big Data Technology at <a href="https://www.sustech.edu.cn/en/" target="_blank" rel="noopener noreferrer">Southern University of Science and Technology (SUSTech)</a>, Shenzhen. I focus on building AI agents and turning complex workflows into clear, polished and efficient products. I enjoy making tools that reduce repetitive work and help people get things done.</p>
  </section>
  <section id="interests" class="home-section" data-section aria-labelledby="interests-title">
    <h2 id="interests-title">Research Interests</h2>
    <ul class="interest-list"><li>Large Language Models and AI Agents</li><li>Agent Workflows and Tool Use</li><li>Group-Robust Learning</li></ul>
  </section>
  <section id="writing" class="home-section publications" data-section aria-labelledby="writing-title">
    <h2 id="writing-title">Publications & Manuscripts</h2>
    {publications.map(publication => { const paper = articles.find(article => article.slug === publication.slug)!; return <article class="publication-row" id={`article-card-${paper.slug}`}>
      <a class="publication-image" href={`/articles/${paper.slug}/`} data-astro-prefetch aria-label={publication.name}><span class="publication-badge">{publication.name}</span><img src={paper.coverImage} alt={paper.coverAltEn} width="1280" height="720" loading="lazy" decoding="async" /></a>
      <div class="publication-copy">
        <h3><a href={`/articles/${paper.slug}/`} data-astro-prefetch>{paper.titleEn}</a></h3>
        <p class="publication-authors"><Authors authors={publication.authors} /></p><p class="publication-venue">{publication.status.en}</p>
        <p class="publication-description">{publication.description.en}</p>
        <div class="publication-links"><a href={publication.pdf} target="_blank" rel="noopener noreferrer">PDF</a>{publication.preprint && <a href={publication.preprint} target="_blank" rel="noopener noreferrer">arXiv</a>}<a href={`/articles/${paper.slug}/`} data-astro-prefetch>Notes</a></div>
      </div>
    </article>; })}
  </section>
  <section id="projects" class="home-section publications" data-section aria-labelledby="projects-title">
    <h2 id="projects-title">Projects</h2>
    {projects.map(project => { const article = articles.find(item => item.slug === project.article)!; return <article class="publication-row" id={`article-card-${project.article}`}>
      <a class="publication-image project-image" href={`/articles/${project.article}/`} data-astro-prefetch aria-label={project.name}><span class="publication-badge">{project.name === 'PPT-Agent' ? 'PPT-Agent' : 'OpenClaw'}</span><img src={project.image} alt={project.alt.en} width="560" height="360" loading="lazy" decoding="async" /></a>
      <div class="publication-copy"><h3><a href={`/articles/${project.article}/`} data-astro-prefetch>{project.name}</a></h3><p class="publication-venue">{project.type.en}</p><p class="publication-description">{article.summaryEn}</p><div class="publication-links"><a href={project.github} target="_blank" rel="noopener noreferrer">Code</a>{project.demo && <a href={project.demo} target="_blank" rel="noopener noreferrer">Demo</a>}<a href={`/articles/${project.article}/`} data-astro-prefetch>Article</a></div></div>
    </article>; })}
  </section>
  <section id="offscreen" class="home-section" data-section aria-labelledby="offscreen-title">
    <h2 id="offscreen-title">Beyond Research</h2>
    <p>Away from the screen, I run and play badminton. My personal best for 1,000 metres is 3:05. Coding and training feel similar to me: both reward steady practice, good rhythm and small improvements that become visible over time.</p>
    <p>Feel free to get in touch via <a href={`mailto:${profile.email}`}>email</a> or find my work on <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a>.</p>
  </section>
</BaseLayout>
