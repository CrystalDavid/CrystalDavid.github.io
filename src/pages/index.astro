---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/site';
import { publications } from '../data/publications';
import Authors from '../components/Authors.astro';
import Education from '../components/Education.astro';
import Thumbnail from '../components/Thumbnail.astro';
---
<BaseLayout>
  <section id="about" class="home-section" data-section aria-labelledby="about-title" tabindex="-1">
    <h2 id="about-title">About Me</h2>
    <p class="about-copy">I’m David, a student in Data Science and Big Data Technology at Southern University of Science and Technology, Shenzhen. I focus on building AI agents and turning complex workflows into clear, polished and efficient products. I enjoy making tools that reduce repetitive work and help people get things done.</p>
  </section>
  <section id="education" class="home-section" data-section aria-labelledby="education-title" tabindex="-1">
    <h2 id="education-title">Education</h2>
    <Education />
  </section>
  <section id="interests" class="home-section" data-section aria-labelledby="interests-title" tabindex="-1">
    <h2 id="interests-title">Research Interests</h2>
    <ul class="interest-list" role="list"><li><span>Large Language Models and AI Agents</span></li><li><span>Agent Workflows and Tool Use</span></li><li><span>Group-Robust Learning</span></li></ul>
  </section>
  <section id="publications" class="home-section" data-section aria-labelledby="publications-title" tabindex="-1">
    <h2 id="publications-title">Publications</h2>
    {publications.map(publication => <article class="publication-row" id={`publication-${publication.slug}`}>
      <div class="publication-image"><Thumbnail src={publication.cover} alt={publication.coverAlt} /></div>
      <div class="publication-copy">
        <h3>{publication.title}</h3>
        <p class="publication-authors"><Authors authors={publication.authors} /></p>
        {publication.preprint && <div class="publication-links"><a href={publication.preprint} target="_blank" rel="noopener noreferrer">arXiv</a></div>}
      </div>
    </article>)}
  </section>
  <section id="projects" class="home-section" data-section aria-labelledby="projects-title" tabindex="-1">
    <h2 id="projects-title">Projects</h2>
    {projects.map(project => <article class="publication-row" id={`project-${project.slug}`}>
      <a class="publication-image project-image" href={project.github} target="_blank" rel="noopener noreferrer" aria-label={`${project.name} on GitHub`}><Thumbnail src={project.image} alt={project.alt} /></a>
      <div class="publication-copy"><h3>{project.name}</h3><p class="project-type">{project.type}</p><div class="publication-links"><a href={project.github} target="_blank" rel="noopener noreferrer">Code</a>{project.demo && <a href={project.demo} target="_blank" rel="noopener noreferrer">Demo</a>}</div></div>
    </article>)}
  </section>
  <script>
    import '../scripts/site';
  </script>
</BaseLayout>
