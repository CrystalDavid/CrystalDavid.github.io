---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { articles, readingMinutes, type Article } from '../../data/articles';
import { publications } from '../../data/publications';
import Authors from '../../components/Authors.astro';
export function getStaticPaths() { return articles.map(article => ({ params: { slug: article.slug }, props: { article } })); }
interface Props { article: Article; }
const { article } = Astro.props;
const publication = publications.find(paper => paper.slug === article.slug);
---
<BaseLayout title={`${article.titleEn} — David`} description={article.summaryEn} article={article}>
  <div class="article-topbar"><a class="inline-link quiet-link" href={`/#article-card-${article.slug}`} data-astro-prefetch><Icon name="back" size={16} />Writing</a><span class="reading-time">{readingMinutes(article)} min read</span></div>
  <article class="article-document">
    <header class="article-header">
      <h1>{article.titleEn}</h1>
      {publication && <><p class="article-byline"><Authors authors={publication.authors} /></p><p class="article-status">{publication.status.en}</p></>}
      <p class="article-summary">{article.summaryEn}</p>
      <a class="source-link inline-link" href={article.sourceHref} target="_blank" rel="noopener noreferrer">{article.sourceLabelEn}<Icon name="arrow" size={15} /></a>
      {publication?.pdf && article.sourceHref !== publication.pdf && <div class="publication-links"><a href={publication.pdf} target="_blank" rel="noopener noreferrer">Paper PDF</a></div>}
      <figure class:list={['article-cover', { 'paper-cover': publication }]}><img src={article.coverImage} alt={article.coverAltEn} width="1280" height="720" fetchpriority="high" decoding="async" /></figure>
    </header>
    <div class="article-body">
      {article.sections.map((section, index) => <section id={`section-${index + 1}`} data-section aria-labelledby={`heading-${index + 1}`}>
        <h2 id={`heading-${index + 1}`}><span class="article-section-number">{String(index + 1).padStart(2, '0')}</span>{section.headingEn}</h2>
        {section.blocks.map(block => {
          if (block.type === 'paragraph') return <p>{block.en}</p>;
          if (block.type === 'subheading') return <h3>{block.en}</h3>;
          if (block.type === 'code') return <div class="code-block"><div class="code-toolbar"><span>{block.language}</span><button type="button" data-copy-code><Icon name="copy" size={14} />Copy</button></div><pre tabindex="0"><code>{block.code}</code></pre></div>;
          if (block.type === 'list') { const Tag = block.ordered ? 'ol' : 'ul'; return <Tag>{block.items.map(item => <li>{item.en}</li>)}</Tag>; }
        })}
      </section>)}
    </div>
  </article>
</BaseLayout>
