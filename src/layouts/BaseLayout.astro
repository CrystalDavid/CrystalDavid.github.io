---
import '../styles/global.css';
import nunitoRegular from '../assets/fonts/nunito-core-400.woff2';
import nunitoBold from '../assets/fonts/nunito-core-700.woff2';
import Sidebar from '../components/Sidebar.astro';
interface Props { title?: string; description?: string; }
const { title = 'David — Personal Homepage', description = 'David’s personal homepage. AI agents, data science, research and projects.' } = Astro.props;
const isHome = Astro.url.pathname === '/';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="David" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-lightning-large-16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="/favicon-lightning-large-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-lightning-large.svg" type="image/svg+xml" sizes="any" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/social.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href={nunitoRegular} as="font" type="font/woff2" crossorigin fetchpriority="high" />
    <link rel="preload" href={nunitoBold} as="font" type="font/woff2" crossorigin fetchpriority="high" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <Sidebar isHome={isHome} />
      <main id="main" class:list={['main-content', { 'main-content--home': isHome }]} tabindex="-1">
        <slot />
      </main>
    </div>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
